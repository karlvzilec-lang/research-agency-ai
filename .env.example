# ── LLM routing mode ─────────────────────────────────────────────────────────
# auto (default): prefer your Claude subscription (passthru), fall back to the
#                  API chain below if the subscription isn't available or fails.
# passthru:        only use your logged-in Claude subscription.
# api:              only use the direct API key chain below.
# mock:             no network calls at all — for dry runs / CI.
LLM_MODE=auto

# ── Option 1: Claude subscription passthrough ───────────────────────────────
# No key needed here. This mode shells out to your own locally installed and
# already-authenticated `claude` CLI (the same one Claude Code uses), so it
# rides whatever plan you're logged into (Pro/Max/Team) instead of separate
# per-token API billing. Requirements:
#   1. Install the CLI:  npm install -g @anthropic-ai/claude-code
#   2. Log in once:      claude /login
# Optional overrides:
# CLAUDE_CLI_PATH=claude          # if the binary isn't on PATH
# CLAUDE_PASSTHRU_MODEL=sonnet    # model alias passed to `claude --model`

# ── Option 2: Direct API keys ────────────────────────────────────────────────
# Used in "api" mode, and as the auto-fallback chain in "auto" mode.
# Tried in this order: Anthropic -> OpenAI -> OpenRouter (multi-key waterfall).

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5

# OpenRouter: comma-separated list of keys, tried in priority order. A key that
# fails (401/403/429/5xx/network error) is put on cooldown and the next key in
# the list is tried immediately — a waterfall, not round-robin. On the *next*
# call the router always starts again from key #1 unless it's still cooling down.
OPENROUTER_API_KEYS=sk-or-v1-aaaa,sk-or-v1-bbbb,sk-or-v1-cccc
OPENROUTER_MODEL=anthropic/claude-sonnet-5
OPENROUTER_COOLDOWN_SECONDS=60
